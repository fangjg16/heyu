# Copy to .env.local for Vite (never commit real keys).
# 前端构建会把 VITE_ 变量打进静态资源；Publishable Key 可以公开，Secret Key 不要放这里。

VITE_ENABLE_LIVE_CHAT=1
VITE_AI_CHAT_ENDPOINT=http://127.0.0.1:8787/api/chat

# Clerk Dashboard → API keys → Publishable key（可公开）
VITE_CLERK_PUBLISHABLE_KEY=pk_test_a2luZC1maXNoLTU2NTMuY2xlcmsuYWNjb3VudHMuZGV2JA
