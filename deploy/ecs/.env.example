# Copy to deploy/ecs/.env and fill (never commit .env)

# --- MySQL ---
MYSQL_ROOT_PASSWORD=change-me-root-password-strong
MYSQL_DATABASE=yuhu_hk
MYSQL_USER=jfo
MYSQL_PASSWORD=change-me-mysql-password-strong
MYSQL_BRIDGE_KEY=

# --- MinIO ---
MINIO_ACCESS_KEY=jfo-minio-access
MINIO_SECRET_KEY=change-me-minio-secret-16chars
MINIO_BUCKET=family-office-platform
MINIO_REGION=us-east-1
MINIO_MAX_UPLOAD_BYTES=52428800

# --- LLM (your existing OpenAI-compatible key) ---
# 必须是百炼「有效」API-KEY（控制台创建；错误会返回 invalid_api_key）
LLM_API_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=replace-with-your-llm-key
LLM_MODEL=qwen-plus

# --- Optional Tavily ---
TAVILY_API_KEY=

# --- Hermes / internal bridge (>= 16 ASCII chars each) ---
HERMES_API_KEY=replace-with-hermes-key-16chars
JFO_INTERNAL_KEY=replace-with-jfo-bridge-16chars
JFO_DEFAULT_USER_ID=CandiceGuo

# Public API base as seen by browsers / Hermes materials fetch.
# Phase 1: set AFTER reading cloudflared logs, e.g. https://xxxx.trycloudflare.com
# Then: docker compose ... up -d jfo-api hermes  (to refresh env)
JFO_API_PUBLIC_BASE=https://REPLACE-WITH-TUNNEL-URL

# GitHub Pages origin (CORS)
ALLOWED_ORIGIN=https://fangjg16.github.io

# --- Clerk（真实注册/登录；pk_ 可公开，sk_ 仅后端）---
# Dashboard: https://dashboard.clerk.com → API keys
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
# 可选：Frontend API，例如 https://xxx.clerk.accounts.dev
CLERK_JWT_ISSUER=
CLERK_JWKS_URL=
CLERK_JWT_KEY=
CLERK_AUTHORIZED_PARTIES=https://fangjg16.github.io,http://localhost:5173
