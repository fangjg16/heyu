# Copy to local.dev.secrets.env and fill in (never commit the real file).
# Generate: powershell -ExecutionPolicy Bypass -File scripts/generate-local-config.ps1

# --- LLM (OpenAI-compatible) ---
LLM_API_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=replace-with-your-llm-key
LLM_MODEL=qwen-plus
QWEN_OCR_MODEL=qwen3.5-ocr
QWEN_VL_MODEL=qwen3-vl-plus

# --- Tavily (optional; Worker web search) ---
TAVILY_API_KEY=replace-with-your-tavily-key-or-placeholder-xxxxxxxx

# --- Local Hermes <-> Worker (ASCII, >= 16 chars each) ---
HERMES_API_KEY=replace-with-hermes-key-16chars
JFO_INTERNAL_KEY=replace-with-jfo-bridge-16chars

# --- Optional default workspace userId ---
JFO_DEFAULT_USER_ID=CandiceGuo

# --- Clerk（本地真实注册/登录；Secret Key 必填才能接通后端）---
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=pk_test_a2luZC1maXNoLTU2NTMuY2xlcmsuYWNjb3VudHMuZGV2JA
CLERK_JWT_ISSUER=https://kind-fish-5653.clerk.accounts.dev
CLERK_JWKS_URL=
CLERK_JWT_KEY=
CLERK_AUTHORIZED_PARTIES=http://localhost:5173,http://127.0.0.1:5173

# --- MySQL 8 ---
DB_DRIVER=mysql
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=jfo
MYSQL_PASSWORD=replace-with-mysql-password
MYSQL_DATABASE=yuhu_hk
MYSQL_BRIDGE_URL=http://127.0.0.1:8790

# --- MinIO / S3-compatible ---
FILE_DRIVER=minio
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_ACCESS_KEY=replace-with-minio-access
MINIO_SECRET_KEY=replace-with-minio-secret
MINIO_BUCKET=family-office-platform
MINIO_REGION=us-east-1
MINIO_MAX_UPLOAD_BYTES=52428800
